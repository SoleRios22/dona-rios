# Copiá este archivo a .env.local y completá con los datos de tu proyecto Supabase
# (Supabase Dashboard > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública real del sitio (sin barra final). Se usa para SEO: sitemap, metadata y datos
# estructurados. En producción (Vercel) esta variable tiene que estar en:
# https://www.xn--doarios-5za.com.ar   (es "doñarios.com.ar" en su forma técnica/punycode,
# la que realmente resuelve — no pongas la ñ directamente acá)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
